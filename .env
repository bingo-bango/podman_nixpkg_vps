# ==============================================================================
# VPS Stack Configuration & Secrets Template
# Copy this file to '.env' and fill in your actual values.
# NEVER commit '.env' to Git!
# ==============================================================================

# --- Hostens VPS & WireGuard ---
VPS_PRIVATE_KEY="_VPS_PRIVATE_KEY"
HOME_SERVER_PUBLIC_KEY="_HOME_SERVER_PUBLIC_KEY"

# --- Stack Configuration ---
TIMEZONE="Europe/Paris"
VW_ADMIN_TOKEN="YOUR_VAULTWARDEN_ADMIN_ARGON2_OR_PLAIN_TOKEN"

# --- Backup Encryption ---
BACKUP_PASSPHRASE="YOUR_SECURE_GPG_PASSPHRASE"

# --- Option B: Environment-Driven pCloud Authentication ---
RCLONE_CONFIG_PCLOUD_TYPE="pcloud"
RCLONE_CONFIG_PCLOUD_TOKEN='{"access_token":"ACTUAL_TOKEN_CODE","token_type":"bearer","expiry":"0001-01-01T00:00:00Z"}'

# --- Traefik Auth ---
TRAEFIK_BASIC_AUTH_USERS="admin:$$ACTUAL_AUTH_KEY"
